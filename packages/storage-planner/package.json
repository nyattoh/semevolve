    "test:consumers": "tsc -p ../../tests/mechanism/storage/tsconfig.json"
  },
  "dependencies": {
    "@semevolve/core": "0.0.0",
    "@semevolve/evaluator": "0.0.0",
    "@semevolve/language-registry": "0.0.0",
    "@semevolve/policy": "0.0.0"
  }
}
